{
  "expo": {
    "name": "Habesha Restaurant",
    "slug": "habesha-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habesha.restaurant"
    },
    "android": {
      "package": "com.habesha.restaurant"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1410"
        }
      ]
    ],
    "scheme": "habesha"
  }
}
