PORT=5001
NODE_ENV=development
CORS_ORIGINS=

# MySQL / phpMyAdmin
DB_HOST=localhost
DB_PORT=3306
DB_NAME=habesha_restaurant
DB_USER=root
DB_PASSWORD=
DB_SSL=false
# Paste the database provider's CA certificate here when DB_SSL=true, if required.
DB_SSL_CA=

# JWT (Admin dashboard)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
INITIAL_ADMIN_PASSWORD=
INITIAL_MANAGER_PASSWORD=

# ─── In-Memory Cache (Redis) ─────────────────────────────────────────────────
# High-speed active order caching and low latency during peak hours
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300

# ─── Offline Sync (Local SQLite / CouchDB) ────────────────────────────────────
# Offline terminal functionality during network drops
OFFLINE_SYNC_ENABLED=true
SQLITE_DB_PATH=./data/offline.sqlite
COUCHDB_URL=http://localhost:5984
COUCHDB_DB_NAME=habesha_offline

# ─── Payment Security (P2PE & Tokenization) ───────────────────────────────────
# Complete PCI-DSS scope reduction — no raw card data stored
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_API_SECRET=your_payment_api_secret_here
PAYMENT_TOKENIZATION_ENABLED=true
P2PE_ENCRYPTION_KEY=your_p2pe_encryption_key_here

# ─── Identity & Access (RBAC + POS PINs + MFA) ───────────────────────────────
# Prevention of unauthorized access and internal theft
RBAC_ENABLED=true
POS_PIN_SALT_ROUNDS=12
MFA_ENABLED=true
MFA_ISSUER=HabeshaRestaurant
MFA_SECRET_LENGTH=20
SESSION_SECRET=change_this_to_a_long_random_string_in_production
SESSION_TIMEOUT_MINUTES=30

# ─── Data Protection (TLS 1.3 + AES-256) ─────────────────────────────────────
# End-to-end data encryption in transit and at rest
TLS_ENABLED=true
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
AES_ENCRYPTION_KEY=your_32_byte_hex_aes_256_key_here
AES_IV_LENGTH=16
ENCRYPTION_ALGORITHM=aes-256-cbc
